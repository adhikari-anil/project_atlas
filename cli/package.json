{
  "name": "projecthub-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "projecthub": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmod } from 'node:fs/promises'; await chmod('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}